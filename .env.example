# ----- 데이터베이스 -----
# 기본: 설치 필요 없는 SQLite. PostgreSQL 예: postgresql+psycopg://user:password@localhost:5432/ruti
DATABASE_URL=sqlite:///./ruti.db

# ----- AI -----
# API 키는 절대 공유하거나 Git에 올리지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RUTI_MAX_OUTPUT_TOKENS=500
RUTI_MAX_PRODUCTS_IN_PROMPT=30
RUTI_HISTORY_TURNS=6

# ----- 계정/보안 -----
RUTI_ALLOW_SIGNUP=true
RUTI_SESSION_HOURS=168
RUTI_CHAT_RATE_PER_MIN=10
RUTI_LOGIN_RATE_PER_15MIN=10
RUTI_SIGNUP_RATE_PER_HOUR=10
RUTI_MAX_MEMORIES=50

# ----- 식약처 공공데이터 (data.go.kr) -----
# 마이페이지의 '일반 인증키(Decoding)' 값
DATA_GO_KR_SERVICE_KEY=
# 각 API 상세 페이지의 End Point 주소 (뒤에 붙는 get... 이름은 자동으로 붙음. 직접 적어도 됨)
MFDS_INGREDIENT_URL=https://apis.data.go.kr/1471000/CsmtcsIngdCpntInfoService01
MFDS_RESTRICTED_URL=https://apis.data.go.kr/1471000/CsmtcsUseRstrcInfoService
MFDS_FUNCTIONAL_REPORT_URL=https://apis.data.go.kr/1471000/FtnltCosmRptPrdlstInfoService01
MFDS_FUNCTIONAL_REVIEW_URL=https://apis.data.go.kr/1471057/FtnltCosmSrngPrdlstInfoService05
MFDS_COSMETICS_INFO_URL=
