# ----- 데이터베이스 -----
# 기본: 설치 필요 없는 SQLite. PostgreSQL 예: postgresql+psycopg://user:password@localhost:5432/ruti
DATABASE_URL=sqlite:///./ruti.db

# ----- AI -----
# API 키는 절대 공유하거나 Git에 올리지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RUTI_MAX_OUTPUT_TOKENS=500
# 하루 AI 비용 상한 (USD, 0이면 제한 없음). 초과하면 그날은 AI 상담·사진 분석이 멈추고 안내 문구가 나감
RUTI_DAILY_BUDGET_USD=0
# 비용 추정용 단가 (USD / 100만 토큰). 사용하는 모델의 실제 가격으로 맞추세요
OPENAI_PRICE_INPUT_PER_M=0.40
OPENAI_PRICE_OUTPUT_PER_M=1.60
# 예비 AI (선택): 주 공급자가 한도 초과·장애일 때 자동 전환. OpenAI 호환 주소면 어디든 가능 (유료 API 권장)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PRICE_INPUT_PER_M=0
LLM_FALLBACK_PRICE_OUTPUT_PER_M=0
# 같은 요청 응답 캐시 (개수, 유지 시간)
RUTI_LLM_CACHE_SIZE=500
RUTI_LLM_CACHE_TTL_SECONDS=86400
RUTI_MAX_PRODUCTS_IN_PROMPT=15
RUTI_HISTORY_TURNS=6

# ----- 계정/보안 -----
RUTI_ALLOW_SIGNUP=true
RUTI_SESSION_HOURS=168
RUTI_CHAT_RATE_PER_MIN=10
RUTI_LOGIN_RATE_PER_15MIN=10
RUTI_SIGNUP_RATE_PER_HOUR=10
RUTI_MAX_MEMORIES=50
RUTI_SCAN_PER_DAY=20

# ----- 식약처 공공데이터 (data.go.kr) -----
# 마이페이지의 '일반 인증키(Decoding)' 값
DATA_GO_KR_SERVICE_KEY=
# 아래 주소는 비워 두면 기본값(app/mfds.py DEFAULT_URLS)을 씁니다. 바뀌었을 때만 입력하세요.
MFDS_INGREDIENT_URL=
MFDS_RESTRICTED_URL=
MFDS_FUNCTIONAL_REPORT_URL=
MFDS_FUNCTIONAL_REVIEW_URL=
MFDS_COSMETICS_INFO_URL=
