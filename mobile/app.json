{
  "expo": {
    "name": "RUTI",
    "slug": "ruti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ruti",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.ruti.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "화장품 성분표를 찍어 내 피부에 맞는지 분석하려면 카메라가 필요해요.",
        "NSPhotoLibraryUsageDescription": "앨범에 있는 성분표 사진을 분석하려면 사진 접근이 필요해요."
      }
    },
    "android": {
      "package": "app.ruti.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4F7D6E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": { "backgroundColor": "#1B1816", "image": "./assets/images/splash-icon.png" }
        }
      ]
    ],
    "extra": {
      "serverUrl": "https://ruti.onrender.com"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
